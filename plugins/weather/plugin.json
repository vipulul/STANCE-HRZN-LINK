{
  "id": "weather",
  "name": "Weather",
  "description": "Live temperature, forecast conditions, wind, and configurable weather event alerts.",
  "version": "1.0.0",
  "basePriority": 8,
  "defaultDynamicMode": "on_event",
  "supportsOnEvent": true,
  "defaultSettings": {
    "dynamicMode": "on_event",
    "userPriority": 8,
    "accentColor": "#00f0ff",
    "cityName": "Bucharest",
    "latitude": 44.4268,
    "longitude": 26.1025,
    "showCondition": true,
    "showHighLow": true,
    "showHumidity": true,
    "showWind": true,
    "showCornerBrackets": true,
    "alertOnSevereWeather": true,
    "triggerOnRain": true,
    "triggerOnStorm": true,
    "triggerOnSnow": true,
    "triggerOnFog": false,
    "triggerOnDrizzle": false,
    "triggerOnHighWind": true,
    "windThresholdKmh": 30,
    "triggerOnExtremeTemp": false,
    "tempLowThresholdC": 0,
    "tempHighThresholdC": 35
  }
}
