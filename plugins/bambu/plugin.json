{
  "id": "bambu",
  "name": "Bambu Lab Printer",
  "description": "Live print progress, nozzle & bed temperatures, layer count, ETA, and automatic print-start split screen.",
  "version": "1.0.0",
  "basePriority": 8,
  "defaultDynamicMode": "on_event",
  "supportsOnEvent": true,
  "defaultSettings": {
