    "serialNumber": "",
    "accessCode": "",
    "printerName": "BAMBU LAB",
    "mockMode": false,
    "mockState": "RUNNING",
    "showTemperatures": true,
    "showChamberTemp": true,
    "showSecondNozzle": true,
    "showLayerCount": true,
    "showRemainingTime": true,
    "showPrintStage": true,
    "showCornerBrackets": true,
